/*FONTS*/
<style>
:root{
  --paper:#F5F0E8;
  --paper-2:#FBF8F2;
  --ink:#2A2520;
  --ink-soft:#5E5548;
  --gold:#7E6329;        /* AA-safe gold for text on paper */
  --gold-line:#B89A5C;   /* ornament / rule gold */
  --rule:#DED5C6;
  --rule-soft:#E8E1D4;
  --muted:#6E6558;       /* AA-safe muted text on paper */
  --deep:#1A1410;
  --cream:#F5F0E8;
  --maxw:1120px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);
  font-family:'Cormorant Garamond',Garamond,'Times New Roman',serif;
  font-size:19px;line-height:1.72;font-weight:400;letter-spacing:.015em;-webkit-font-smoothing:antialiased}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 30px}
.narrow{max-width:760px;margin:0 auto}
a{color:inherit}
/* height:auto is required: the width/height attributes on each <img> are
   presentational hints that reserve the aspect ratio, and without this the
   pixel height wins and the image stretches */
img{max-width:100%;height:auto;display:block}

/* skip link — first thing a keyboard lands on */
.skip{position:absolute;left:50%;top:0;transform:translate(-50%,-140%);z-index:100;
  background:var(--ink);color:var(--paper);text-decoration:none;
  font-family:'Cinzel',Georgia,serif;font-size:12px;letter-spacing:.24em;text-transform:uppercase;
  padding:14px 24px;transition:transform .15s}
.skip:focus{transform:translate(-50%,0)}

.notice{background:var(--ink);color:var(--paper);text-align:center;padding:11px 20px;
  font-family:'Cinzel',Georgia,serif;font-size:12px;letter-spacing:.26em;text-transform:uppercase}
@media(max-width:520px){.notice{font-size:11px;letter-spacing:.16em}}

header{border-bottom:1px solid var(--rule)}
.nav{display:flex;align-items:center;justify-content:center;gap:38px;padding:26px 0;
  font-family:'Cinzel',Georgia,serif;font-size:13px;letter-spacing:.26em;text-transform:uppercase}
.nav a{position:relative;text-decoration:none;color:var(--gold);border-bottom:1px solid transparent;padding-bottom:2px;transition:.2s}
.nav a:hover,.nav a.on{color:var(--ink);border-color:var(--gold-line)}
/* grows the tap target to ~44px without pushing the .on underline off the text */
.nav a::after{content:"";position:absolute;left:0;right:0;top:-13px;bottom:-13px}
@media(max-width:520px){.nav{gap:20px;font-size:11px;letter-spacing:.18em}}

/* key ornament — the mark from the front of the card */
.keyrule{display:flex;align-items:center;justify-content:center;gap:20px;margin:44px 0}
.keyrule::before,.keyrule::after{content:"";width:74px;height:1px;background:var(--gold-line);opacity:.65}
.keyrule svg{display:block;width:104px;height:auto}
@media(max-width:520px){.keyrule::before,.keyrule::after{width:38px}}

.kicker{font-family:'Cinzel',Georgia,serif;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin:0 0 20px}
h1{font-family:'Cinzel',Georgia,serif;font-weight:400;text-transform:uppercase;
  font-size:clamp(26px,4vw,40px);line-height:1.3;letter-spacing:.13em;margin:0}
h2{font-family:'Cinzel',Georgia,serif;font-weight:400;text-transform:uppercase;
  font-size:clamp(20px,2.6vw,26px);letter-spacing:.18em;margin:0 0 24px;text-align:center}

/* ---------- product hero ---------- */
.product{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:start;padding:64px 0 10px}
@media(max-width:860px){.product{grid-template-columns:1fr;gap:40px;max-width:520px;margin:0 auto}}
.plate{border:1px solid var(--rule);background:#fff;padding:14px}
.plate img{width:100%}
.buy{padding-top:6px}
.pmeta{font-family:'Cinzel',Georgia,serif;font-size:12px;letter-spacing:.2em;text-transform:uppercase;
  color:var(--ink-soft);margin:20px 0 0}
.pprice{font-family:'Cinzel',Georgia,serif;font-size:30px;letter-spacing:.08em;color:var(--gold);margin:20px 0 0}
.pprice span{font-family:'Cormorant Garamond',Garamond,serif;font-size:18px;letter-spacing:.03em;
  color:var(--ink-soft);text-transform:none;display:block;margin-top:8px}
.blurb{color:var(--ink-soft);margin:24px 0 0}

.btn{display:inline-block;font-family:'Cinzel',Georgia,serif;font-size:11.5px;letter-spacing:.3em;text-transform:uppercase;
  padding:17px 38px;text-decoration:none;cursor:pointer;background:var(--ink);color:var(--paper);
  border:1px solid var(--ink);transition:.2s}
.btn:hover{background:var(--gold);border-color:var(--gold);color:#fff}
/* <button> defaults to line-height:normal, which made it 4px shorter than an <a class="btn"> */
button.btn{line-height:1.72}
.buybox{margin:30px 0 0}

/* price breakdown */
.ledger{margin:30px 0 0;border-top:1px solid var(--rule);font-size:17.5px}
.ledger div{display:flex;justify-content:space-between;gap:20px;padding:11px 0;border-bottom:1px solid var(--rule-soft);color:var(--ink-soft)}
.ledger div.total{border-bottom:0;border-top:1px solid var(--rule);color:var(--ink);
  font-family:'Cinzel',Georgia,serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:16px 0 0;margin-top:4px}
.ledger .note{display:block;font-size:15.5px;color:var(--muted);padding:16px 0 0;border:0;letter-spacing:.02em;line-height:1.6}

/* ---------- detail columns ---------- */
.cols{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding:10px 0 0}
@media(max-width:820px){.cols{grid-template-columns:1fr;gap:34px}}
/* these are h2s (they follow the h1 directly — an h3 here skipped a level);
   this rule restyles them back to the small ruled column head */
.col h2{font-family:'Cinzel',Georgia,serif;font-weight:400;font-size:11px;letter-spacing:.26em;text-transform:uppercase;
  text-align:left;color:var(--gold);margin:0 0 20px;padding-bottom:12px;border-bottom:1px solid var(--rule)}
.col ul{list-style:none;margin:0;padding:0}
.col li{padding:11px 0;border-bottom:1px solid var(--rule-soft);color:var(--ink-soft)}
.col ol{margin:0;padding-left:22px;color:var(--ink-soft)}
.col ol li{border:0;padding:7px 0}
.swatchrow{display:flex;gap:8px;margin-top:22px}
.swatchrow i{display:block;width:34px;height:8px}

/* ---------- how a spread works ---------- */
.spread{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,340px);gap:56px;align-items:center;padding:0 0 20px}
@media(max-width:860px){.spread{grid-template-columns:1fr;gap:32px;max-width:560px;margin:0 auto}}
.spread figure{margin:0;border:1px solid var(--rule);background:#fff;padding:12px}
.spread p{color:var(--ink-soft);margin:0 0 18px}

/* ---------- gallery ---------- */
.credits{text-align:center;color:var(--ink-soft);font-size:17px;letter-spacing:.05em;margin:52px 0 0}

/* ---------- inside the book ---------- */
.mosaic{margin:8px 0 0}
.mosaic img{width:100%;border:1px solid var(--rule)}
.mcap{text-align:center;color:var(--ink-soft);font-size:17.5px;max-width:46ch;margin:22px auto 0}
.cut{margin:66px auto 0;max-width:380px}
/* .plate here is a <figure>: without this the UA's `margin:1em 40px` shrank it to 300px */
.cut .plate{padding:12px;margin:0}

/* ---------- closing portal ---------- */
.close{background:var(--deep);color:var(--cream);text-align:center;padding:74px 0 78px;margin-top:80px}
.close .arch{display:flex;justify-content:center;margin:0 0 26px}
.close .arch svg{display:block;width:112px;height:auto}
.close h2{color:#D4B87A;margin-bottom:14px}
.close p{color:#CFC6BA;max-width:38ch;margin:0 auto 30px}
.btn-gold{background:#D4B87A;border-color:#D4B87A;color:#1A1410}
.btn-gold:hover{background:var(--cream);border-color:var(--cream);color:#1A1410}

footer{border-top:1px solid var(--rule);background:var(--paper-2);padding:56px 0;text-align:center}
.fmark{font-family:'Cinzel',Georgia,serif;font-weight:500;text-transform:uppercase;font-size:15px;letter-spacing:.34em;margin:0 0 10px}
.ftitles{font-style:italic;font-size:15px;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);margin:0 0 24px}
.finfo{font-size:18px;line-height:2.2;letter-spacing:.05em}
.finfo a{display:inline-block;padding:6px 2px;color:var(--gold);text-decoration:none;border-bottom:1px solid transparent}
.finfo a:hover{border-color:var(--gold-line)}
/* the email address is a single unbreakable 31-character token; at 320px it
   needs ~290px and has 245px. Shrink the type rather than let it overhang. */
@media(max-width:400px){.finfo{font-size:16px;letter-spacing:.01em}}

/* marks the spots Squarespace takes over */
.sqs{border:1px dashed var(--gold-line);background:rgba(184,154,92,.06);padding:20px 22px;margin:22px 0 0;
  font-size:15px;line-height:1.65;color:var(--muted);letter-spacing:.02em}
.sqs b{font-family:'Cinzel',Georgia,serif;display:block;font-size:9.5px;letter-spacing:.28em;
  text-transform:uppercase;color:var(--gold);margin-bottom:8px;font-weight:400}

/* ---------- keyboard focus ---------- */
a:focus-visible,button:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.btn:focus-visible{outline-offset:4px}
.close a:focus-visible{outline-color:#D4B87A}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.skip{transition:none}}

@media print{.skip{display:none}}
</style>
</head>
